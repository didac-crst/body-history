# Copy values into /srv/satellite/secrets/body-history.env on the host.
# Never commit real secrets, hostnames, or personal addresses.

DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=0
APP_TIMEZONE=Europe/Paris

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=2040
POSTGRES_DB=body_history
POSTGRES_USER=body_history_app
POSTGRES_PASSWORD=replace-me

BODY_HISTORY_IMPORTS_DIR=/data/imports
BODY_HISTORY_EXPORTS_DIR=/data/exports

# Optional: create first admin on empty database at container start
# DJANGO_BOOTSTRAP_ADMIN_USER=yourname
# DJANGO_BOOTSTRAP_ADMIN_PASSWORD=replace-me
# DJANGO_BOOTSTRAP_ADMIN_EMAIL=
